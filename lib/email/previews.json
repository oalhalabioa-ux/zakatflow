{
  "invite.en": "<!doctype html><html lang=\"en\" dir=\"ltr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>You are invited to Yaqeen Business — Yaqeen Business</title></head><body style=\"margin:0;padding:0;background:#f3f5f7;color:#183248;font-family:Tahoma,Arial,sans-serif\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f5f7\"><tr><td align=\"center\" style=\"padding:32px 12px\"><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" dir=\"ltr\" style=\"width:100%;max-width:600px;background:#fff;border:1px solid #e1e6eb;border-radius:16px;overflow:hidden\"><tr><td align=\"center\" bgcolor=\"#102c46\" style=\"padding:30px 24px;border-bottom:3px solid #c7a250\"><img src=\"https://app.yaqeenbiz.com/brand/owner/logo-white-gold.png\" width=\"190\" alt=\"Yaqeen Business\" style=\"display:block;max-width:190px;width:100%;height:auto;border:0\"></td></tr><tr><td align=\"left\" style=\"padding:36px 32px 26px;text-align:left;direction:ltr\"><p style=\"margin:0 0 12px;color:#896927;font-size:12px;font-weight:bold\">ACCOUNT SECURITY</p><h1 style=\"margin:0 0 22px;font-size:26px;line-height:1.6;color:#102c46\">You are invited to Yaqeen Business</h1><p style=\"margin:0 0 20px;font-size:16px;line-height:1.9\">You have been invited to create a Yaqeen Business account. Accept the invitation to verify your email, then set your account password.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 24px\"><tr><td bgcolor=\"#c7a250\" style=\"border-radius:8px\"><a href=\"https://app.yaqeenbiz.com/auth/confirm?lang=en&amp;type=invite&amp;token_hash=preview-token-not-valid\" style=\"display:inline-block;padding:15px 26px;color:#102c46;text-decoration:none;font-size:16px;font-weight:bold;line-height:1.5\">Accept invitation</a></td></tr></table><p style=\"margin:0 0 20px;font-size:16px;line-height:1.9\">This invitation is personal. This email does not automatically grant organization or administrator access; assigned permissions apply only after invitation verification.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#f5f7f9\" style=\"padding:16px 18px;border-radius:8px;font-size:14px;line-height:1.9;color:#475569\">If you did not request this action, do not use the link or code. Visit the platform using its known address to review your account.</td></tr></table></td></tr><tr><td align=\"center\" style=\"padding:22px 24px;border-top:1px solid #e8edf1;color:#64748b;font-size:12px;line-height:1.8\">An automated email to protect your Yaqeen Business account.<br><span dir=\"ltr\">yaqeenbiz.com</span></td></tr></table></td></tr></table></body></html>",
  "invite.ar": "<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>دعوة لإنشاء حسابك في يقين الأعمال — Yaqeen Business</title></head><body style=\"margin:0;padding:0;background:#f3f5f7;color:#183248;font-family:Tahoma,Arial,sans-serif\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f5f7\"><tr><td align=\"center\" style=\"padding:32px 12px\"><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" dir=\"rtl\" style=\"width:100%;max-width:600px;background:#fff;border:1px solid #e1e6eb;border-radius:16px;overflow:hidden\"><tr><td align=\"center\" bgcolor=\"#102c46\" style=\"padding:30px 24px;border-bottom:3px solid #c7a250\"><img src=\"https://app.yaqeenbiz.com/brand/owner/logo-white-gold.png\" width=\"190\" alt=\"يقين الأعمال\" style=\"display:block;max-width:190px;width:100%;height:auto;border:0\"></td></tr><tr><td align=\"right\" style=\"padding:36px 32px 26px;text-align:right;direction:rtl\"><p style=\"margin:0 0 12px;color:#896927;font-size:12px;font-weight:bold\">أمان حسابك</p><h1 style=\"margin:0 0 22px;font-size:26px;line-height:1.6;color:#102c46\">دعوة لإنشاء حسابك في يقين الأعمال</h1><p style=\"margin:0 0 20px;font-size:16px;line-height:1.9\">دُعيت لإنشاء حساب في يقين الأعمال. اضغط لقبول الدعوة وتأكيد بريدك، ثم عيّن كلمة مرور لحسابك.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 24px\"><tr><td bgcolor=\"#c7a250\" style=\"border-radius:8px\"><a href=\"https://app.yaqeenbiz.com/auth/confirm?lang=ar&amp;type=invite&amp;token_hash=preview-token-not-valid\" style=\"display:inline-block;padding:15px 26px;color:#102c46;text-decoration:none;font-size:16px;font-weight:bold;line-height:1.5\">قبول الدعوة</a></td></tr></table><p style=\"margin:0 0 20px;font-size:16px;line-height:1.9\">الدعوة شخصية. لا تمنحك هذه الرسالة صلاحيات مؤسسة أو صلاحيات إدارية تلقائياً؛ تُطبّق الصلاحيات الممنوحة لك بعد التحقق من الدعوة.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#f5f7f9\" style=\"padding:16px 18px;border-radius:8px;font-size:14px;line-height:1.9;color:#475569\">إذا لم تطلب هذه العملية، لا تستخدم الرابط أو الرمز. ادخل إلى المنصة من عنوانها المعروف لمراجعة حسابك.</td></tr></table></td></tr><tr><td align=\"center\" style=\"padding:22px 24px;border-top:1px solid #e8edf1;color:#64748b;font-size:12px;line-height:1.8\">رسالة آلية لحماية حسابك في يقين الأعمال.<br><span dir=\"ltr\">yaqeenbiz.com</span></td></tr></table></td></tr></table></body></html>",
  "email-change.en": "<!doctype html><html lang=\"en\" dir=\"ltr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Confirm your email change — Yaqeen Business</title></head><body style=\"margin:0;padding:0;background:#f3f5f7;color:#183248;font-family:Tahoma,Arial,sans-serif\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f5f7\"><tr><td align=\"center\" style=\"padding:32px 12px\"><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" dir=\"ltr\" style=\"width:100%;max-width:600px;background:#fff;border:1px solid #e1e6eb;border-radius:16px;overflow:hidden\"><tr><td align=\"center\" bgcolor=\"#102c46\" style=\"padding:30px 24px;border-bottom:3px solid #c7a250\"><img src=\"https://app.yaqeenbiz.com/brand/owner/logo-white-gold.png\" width=\"190\" alt=\"Yaqeen Business\" style=\"display:block;max-width:190px;width:100%;height:auto;border:0\"></td></tr><tr><td align=\"left\" style=\"padding:36px 32px 26px;text-align:left;direction:ltr\"><p style=\"margin:0 0 12px;color:#896927;font-size:12px;font-weight:bold\">ACCOUNT SECURITY</p><h1 style=\"margin:0 0 22px;font-size:26px;line-height:1.6;color:#102c46\">Confirm your email change</h1><p style=\"margin:0 0 20px;font-size:16px;line-height:1.9\">An email change was requested for your account. Complete the confirmations sent to your old and new addresses as required by the current security settings.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 24px\"><tr><td bgcolor=\"#c7a250\" style=\"border-radius:8px\"><a href=\"https://app.yaqeenbiz.com/auth/email-action?lang=en&amp;confirmation_url=https%3A%2F%2Fexample.test%2Fpreview-only\" style=\"display:inline-block;padding:15px 26px;color:#102c46;text-decoration:none;font-size:16px;font-weight:bold;line-height:1.5\">Confirm email change</a></td></tr></table><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#f5f7f9\" style=\"padding:16px 18px;border-radius:8px;font-size:14px;line-height:1.9;color:#475569\">If you did not request this action, do not use the link or code. Visit the platform using its known address to review your account.</td></tr></table></td></tr><tr><td align=\"center\" style=\"padding:22px 24px;border-top:1px solid #e8edf1;color:#64748b;font-size:12px;line-height:1.8\">An automated email to protect your Yaqeen Business account.<br><span dir=\"ltr\">yaqeenbiz.com</span></td></tr></table></td></tr></table></body></html>",
