  "reauthentication.en": "<!doctype html><html lang=\"en\" dir=\"ltr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Verify a sensitive action — Yaqeen Business</title></head><body style=\"margin:0;padding:0;background:#f3f5f7;color:#183248;font-family:Tahoma,Arial,sans-serif\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f5f7\"><tr><td align=\"center\" style=\"padding:32px 12px\"><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" dir=\"ltr\" style=\"width:100%;max-width:600px;background:#fff;border:1px solid #e1e6eb;border-radius:16px;overflow:hidden\"><tr><td align=\"center\" bgcolor=\"#102c46\" style=\"padding:30px 24px;border-bottom:3px solid #c7a250\"><img src=\"https://app.yaqeenbiz.com/brand/owner/logo-white-gold.png\" width=\"190\" alt=\"Yaqeen Business\" style=\"display:block;max-width:190px;width:100%;height:auto;border:0\"></td></tr><tr><td align=\"left\" style=\"padding:36px 32px 26px;text-align:left;direction:ltr\"><p style=\"margin:0 0 12px;color:#896927;font-size:12px;font-weight:bold\">ACCOUNT SECURITY</p><h1 style=\"margin:0 0 22px;font-size:26px;line-height:1.6;color:#102c46\">Verify a sensitive action</h1><p style=\"margin:0 0 20px;font-size:16px;line-height:1.9\">Use this verification code to complete the action you started. Never share it with anyone, including through support or chat.</p><p dir=\"ltr\" style=\"padding:18px;text-align:center;letter-spacing:6px;font-size:30px;font-weight:bold;background:#f8f3e9;color:#102c46;border-radius:8px\">12345678</p><p style=\"margin:0 0 20px;font-size:16px;line-height:1.9\">The code expires according to the current authentication policy. If it has expired, request a new one from the platform.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#f5f7f9\" style=\"padding:16px 18px;border-radius:8px;font-size:14px;